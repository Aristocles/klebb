{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://klebb.app/schemas/health-connect/protocol-v1.schema.json",
  "title": "Health connector protocol v1",
  "description": "Structural contracts only. Exact UTF-8, duplicate keys, precision, negotiated limits, authority and state-dependent conditions are specified in protocol-v1.md.",
  "oneOf": [
    {
      "$ref": "#/$defs/capabilities"
    },
    {
      "$ref": "#/$defs/pairingGrant"
    },
    {
      "$ref": "#/$defs/pairingExchange"
    },
    {
      "$ref": "#/$defs/batch"
    },
    {
      "$ref": "#/$defs/durableReceipt"
    },
    {
      "$ref": "#/$defs/coverage"
    },
    {
      "$ref": "#/$defs/aggregate"
    },
    {
      "$ref": "#/$defs/objectPart"
    },
    {
      "$ref": "#/$defs/objectPartReceipt"
    },
    {
      "$ref": "#/$defs/objectFinalise"
    },
    {
      "$ref": "#/$defs/error"
    },
    {
      "$ref": "#/$defs/paired"
    },
    {
      "$ref": "#/$defs/streamStatus"
    },
    {
      "$ref": "#/$defs/connectorList"
    }
  ],
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "recordType": {
      "type": "string",
      "pattern": "^[A-Z][A-Za-z0-9]{0,95}$"
    },
    "int64": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,18})$",
      "description": "Unsigned spelling of a non-negative signed Int64; maximum 9223372036854775807."
    },
    "decimal": {
      "type": "string",
      "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?([eE][+-]?[0-9]+)?$",
      "maxLength": 256
    },
    "instant": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,9})?Z$"
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "secret": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{43,128}$"
    },
    "categories": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/recordType"
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "maxBytes",
        "maxChanges",
        "maxDepth",
        "maxNodes",
        "maxSamples",
        "maxParts",
        "maxObjectBytes"
      ],
      "properties": {
        "maxBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1048576
        },
        "maxChanges": {
          "type": "integer",
          "minimum": 1,
          "maximum": 500
        },
        "maxDepth": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16
        },
        "maxNodes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20000
        },
        "maxSamples": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000
        },
        "maxParts": {
          "type": "integer",
          "minimum": 1,
          "maximum": 128
        },
        "maxObjectBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 67108864
        }
      }
    },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tenantId",
        "instanceId",
        "sourceStoreId",
        "installationId",
        "generation",
        "restoreEpoch"
      ],
      "properties": {
        "tenantId": {
          "$ref": "#/$defs/id"
        },
        "instanceId": {
          "$ref": "#/$defs/id"
        },
        "sourceStoreId": {
          "$ref": "#/$defs/id"
        },
        "installationId": {
          "$ref": "#/$defs/id"
        },
        "generation": {
          "$ref": "#/$defs/int64"
        },
        "restoreEpoch": {
          "$ref": "#/$defs/id"
        }
      }
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tenantId",
        "sourceStoreId",
        "recordType",
        "nativeRecordId"
      ],
      "properties": {
        "tenantId": {
          "$ref": "#/$defs/id"
        },
        "sourceStoreId": {
          "$ref": "#/$defs/id"
        },
        "recordType": {
          "$ref": "#/$defs/recordType"
        },
        "nativeRecordId": {
          "$ref": "#/$defs/id"
        }
      }
    },
    "upsert": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operation",
        "identity",
        "dataFamily",
        "projection",
        "record",
        "serializerId",
        "serializerVersion"
      ],
      "properties": {
        "operation": {
          "const": "upsert"
        },
        "identity": {
          "$ref": "#/$defs/identity"
        },
        "dataFamily": {
          "enum": [
            "ordinary",
            "route",
            "medical"
          ]
        },
        "projection": {
          "enum": [
            "projected",
            "raw-only"
          ]
        },
        "record": {
          "type": "object",
          "minProperties": 1
        },
        "serializerId": {
          "$ref": "#/$defs/id"
        },
        "serializerVersion": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        }
      }
    },
    "delete": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operation",
        "identity"
      ],
      "properties": {
        "operation": {
          "const": "delete"
        },
        "identity": {
          "$ref": "#/$defs/identity"
        }
      }
    },
    "durableReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "kind",
        "binding",
        "recordType",
        "sequence",
        "batchId",
        "payloadDigest"
      ],
      "properties": {
        "version": { "const": 1 },
        "kind": { "const": "durable-receipt" },
        "binding": { "$ref": "#/$defs/binding" },
        "recordType": { "$ref": "#/$defs/recordType" },
        "sequence": { "$ref": "#/$defs/int64" },
        "batchId": { "$ref": "#/$defs/id" },
        "payloadDigest": { "$ref": "#/$defs/digest" }
      }
    },
    "batchPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "binding",
        "recordType",
        "sequence",
        "batchId",
        "changes"
      ],
      "properties": {
        "binding": {
          "$ref": "#/$defs/binding"
        },
        "recordType": {
          "$ref": "#/$defs/recordType"
        },
        "sequence": {
          "$ref": "#/$defs/int64"
        },
        "batchId": {
          "$ref": "#/$defs/id"
        },
        "changes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 500,
          "items": {
            "oneOf": [
              {
                "$ref": "#/$defs/upsert"
              },
              {
                "$ref": "#/$defs/delete"
              }
            ]
          }
        }
      }
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "kind",
        "tenantId",
        "instanceId",
        "restoreEpoch",
        "supportedVersions",
        "limits",
        "categories",
        "serializers"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "kind": {
          "const": "capabilities"
        },
        "tenantId": {
          "$ref": "#/$defs/id"
        },
        "instanceId": {
          "$ref": "#/$defs/id"
        },
        "restoreEpoch": {
          "$ref": "#/$defs/id"
        },
        "supportedVersions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": {
            "const": 1
          }
        },
        "limits": {
          "$ref": "#/$defs/limits"
        },
        "categories": {
          "$ref": "#/$defs/categories"
        },
        "serializers": {
          "type": "array",
          "minItems": 1,
          "maxItems": 128,
          "items": {
            "$ref": "#/$defs/serializer"
          }
        },
        "destination": {
          "type": "string",
          "maxLength": 2048
        },
        "connectorId": {
          "$ref": "#/$defs/id"
        },
        "sourceStoreId": {
          "$ref": "#/$defs/id"
        },
        "installationId": {
          "$ref": "#/$defs/id"
        },
        "streams": {
          "$ref": "#/$defs/streams"
        }
      }
    },
    "pairingGrant": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "kind",
        "tenantId",
        "instanceId",
        "destination",
        "grant",
        "expiresAt",
        "categories",
        "limits"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "kind": {
          "const": "pairing-grant"
        },
        "tenantId": {
          "$ref": "#/$defs/id"
        },
        "instanceId": {
          "$ref": "#/$defs/id"
        },
        "destination": {
          "type": "string",
          "maxLength": 2048
        },
        "grant": {
          "$ref": "#/$defs/secret"
        },
        "expiresAt": {
          "$ref": "#/$defs/instant"
        },
        "categories": {
          "$ref": "#/$defs/categories"
        },
        "limits": {
          "$ref": "#/$defs/limits"
        },
        "sourceStoreId": {
          "$ref": "#/$defs/id"
        },
        "restoreEpoch": {
          "$ref": "#/$defs/id"
        }
      }
    },
    "pairingExchange": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "kind",
        "tenantId",
        "instanceId",
        "grant",
        "installationId",
        "sourceStoreId",
        "categories"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "kind": {
          "const": "pairing-exchange"
        },
        "tenantId": {
          "$ref": "#/$defs/id"
        },
        "instanceId": {
          "$ref": "#/$defs/id"
        },
        "grant": {
          "$ref": "#/$defs/secret"
        },
        "installationId": {
          "$ref": "#/$defs/id"
        },
        "sourceStoreId": {
          "$ref": "#/$defs/id"
        },
        "categories": {
          "$ref": "#/$defs/categories"
        }
      }
    },
    "batch": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "kind",
        "payloadJson",
        "payloadDigest"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "kind": {
          "const": "batch"
        },
        "payloadJson": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1048576
        },
        "payloadDigest": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "window": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "start",
        "end"
      ],
      "properties": {
        "start": {
          "$ref": "#/$defs/instant"
        },
        "end": {
          "$ref": "#/$defs/instant"
        }
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "kind",
        "binding",
        "recordType",
        "window",
        "filterDigest",
        "rawFrontier",
        "status",
        "pagesFinished",
        "permissionsStable",
        "tokenValid",
        "permissionFingerprintStart",
        "permissionFingerprintEnd",
        "historyIncludesScope",
        "changesBarrierDrained",
        "queryJson"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "kind": {
          "const": "coverage"
        },
        "binding": {
          "$ref": "#/$defs/binding"
        },
        "recordType": {
          "$ref": "#/$defs/recordType"
        },
        "window": {
          "$ref": "#/$defs/window"
        },
        "filterDigest": {
          "$ref": "#/$defs/digest"
        },
        "rawFrontier": {
          "$ref": "#/$defs/int64"
        },
        "status": {
          "enum": [
            "partial",
            "complete"
          ]
        },
        "pagesFinished": {
          "type": "boolean"
        },
        "permissionsStable": {
          "type": "boolean"
        },
        "tokenValid": {
          "type": "boolean"
        },
        "permissionFingerprintStart": {
          "$ref": "#/$defs/digest"
        },
        "permissionFingerprintEnd": {
          "$ref": "#/$defs/digest"
        },
        "historyIncludesScope": {
          "type": "boolean"
        },
        "changesBarrierDrained": {
          "type": "boolean"
        },
        "queryJson": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1048576
        }
      }
    },
    "aggregate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "kind",
        "binding",
        "recordType",
        "window",
        "filterDigest",
        "requiredRawFrontier",
        "status",
        "metric",
        "observation",
        "revision",
        "policyVersion",
        "provenance",
        "queryJson"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "kind": {
          "const": "aggregate"
        },
        "binding": {
          "$ref": "#/$defs/binding"
        },
        "recordType": {
          "$ref": "#/$defs/recordType"
        },
        "window": {
          "$ref": "#/$defs/window"
        },
        "filterDigest": {
          "$ref": "#/$defs/digest"
        },
        "requiredRawFrontier": {
          "$ref": "#/$defs/int64"
        },
        "status": {
          "enum": [
            "blocked",
            "lagging",
            "current"
          ]
        },
        "metric": {
          "$ref": "#/$defs/id"
        },
        "observation": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "state",
            "quantity",
            "unit"
          ],
          "properties": {
            "state": {
              "enum": [
                "value",
                "empty",
                "missing"
              ]
            },
            "quantity": {
              "oneOf": [
                {
                  "$ref": "#/$defs/decimal"
                },
                {
                  "type": "null"
                }
              ]
            },
            "unit": {
              "$ref": "#/$defs/id"
            }
          }
        },
        "revision": {
          "$ref": "#/$defs/int64"
        },
        "policyVersion": {
          "$ref": "#/$defs/id"
        },
        "provenance": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "provider",
            "originPackages"
          ],
          "properties": {
            "provider": {
              "const": "health-connect-native"
            },
            "originPackages": {
              "type": "array",
              "maxItems": 128,
              "uniqueItems": true,
              "items": {
                "$ref": "#/$defs/id"
              }
            }
          }
        },
        "queryJson": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1048576
        }
      }
    },
    "objectPart": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "kind",
        "binding",
        "recordType",
        "batchId",
        "sequence",
        "identity",
        "objectId",
        "objectDigest",
        "partIndex",
        "partCount",
        "totalBytes",
        "partBase64",
        "partDigest"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "kind": {
          "const": "object-part"
        },
        "binding": {
          "$ref": "#/$defs/binding"
        },
        "recordType": {
          "$ref": "#/$defs/recordType"
        },
        "batchId": {
          "$ref": "#/$defs/id"
        },
        "sequence": {
          "$ref": "#/$defs/int64"
        },
        "identity": {
          "$ref": "#/$defs/identity"
        },
        "objectId": {
          "$ref": "#/$defs/id"
        },
        "objectDigest": {
          "$ref": "#/$defs/digest"
        },
        "partIndex": {
          "type": "integer",
          "minimum": 0,
          "maximum": 127
        },
        "partCount": {
          "type": "integer",
          "minimum": 1,
          "maximum": 128
        },
        "totalBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 67108864
        },
        "partBase64": {
          "type": "string",
          "minLength": 4,
          "maxLength": 1048576,
          "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
        },
        "partDigest": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "objectPartReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version", "kind", "binding", "recordType", "batchId", "sequence",
        "identity", "objectId", "objectDigest", "partIndex", "partCount",
        "totalBytes", "partDigest", "partBytes"
      ],
      "properties": {
        "version": { "const": 1 },
        "kind": { "const": "object-part-receipt" },
        "binding": { "$ref": "#/$defs/binding" },
        "recordType": { "$ref": "#/$defs/recordType" },
        "batchId": { "$ref": "#/$defs/id" },
        "sequence": { "$ref": "#/$defs/int64" },
        "identity": { "$ref": "#/$defs/identity" },
        "objectId": { "$ref": "#/$defs/id" },
        "objectDigest": { "$ref": "#/$defs/digest" },
        "partIndex": { "type": "integer", "minimum": 0, "maximum": 127 },
        "partCount": { "type": "integer", "minimum": 1, "maximum": 128 },
        "totalBytes": { "type": "integer", "minimum": 1, "maximum": 67108864 },
        "partDigest": { "$ref": "#/$defs/digest" },
        "partBytes": { "type": "integer", "minimum": 1, "maximum": 1048576 }
      }
    },
    "objectFinalise": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "kind",
        "binding",
        "recordType",
        "batchId",
        "sequence",
        "identity",
        "objectId",
        "objectDigest",
        "partCount",
        "totalBytes",
        "parts"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "kind": {
          "const": "object-finalise"
        },
        "binding": {
          "$ref": "#/$defs/binding"
        },
        "recordType": {
          "$ref": "#/$defs/recordType"
        },
        "batchId": {
          "$ref": "#/$defs/id"
        },
        "sequence": {
          "$ref": "#/$defs/int64"
        },
        "identity": {
          "$ref": "#/$defs/identity"
        },
        "objectId": {
          "$ref": "#/$defs/id"
        },
        "objectDigest": {
          "$ref": "#/$defs/digest"
        },
        "partCount": {
          "type": "integer",
          "minimum": 1,
          "maximum": 128
        },
        "totalBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 67108864
        },
        "parts": {
          "type": "array",
          "minItems": 1,
          "maxItems": 128,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "index",
              "bytes",
              "digest"
            ],
            "properties": {
              "index": {
                "type": "integer",
                "minimum": 0,
                "maximum": 127
              },
              "bytes": {
                "type": "integer",
                "minimum": 1,
                "maximum": 1048576
              },
              "digest": {
                "$ref": "#/$defs/digest"
              }
            }
          }
        }
      }
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "kind",
        "code",
        "retryable"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "kind": {
          "const": "error"
        },
        "code": {
          "enum": [
            "invalid-message",
            "unsupported-version",
            "limit-exceeded",
            "binding-mismatch",
            "scope-denied",
            "digest-mismatch",
            "incomplete-coverage",
            "frontier-lag",
            "invalid-destination",
            "expired-grant",
            "conflict",
            "deletion-suppressed",
            "sequence-gap",
            "revoked",
            "storage-unavailable",
            "missing-parts",
            "scope-mismatch",
            "unauthorised"
          ]
        },
        "retryable": {
          "type": "boolean"
        }
      }
    },
    "serializer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version",
        "dataFamily"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "version": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        },
        "dataFamily": {
          "enum": [
            "ordinary",
            "route",
            "medical"
          ]
        }
      }
    },
    "query": {
      "type": "object",
      "required": [
        "recordType",
        "window",
        "dataOrigins",
        "historyStart",
        "features"
      ],
      "properties": {
        "recordType": {
          "$ref": "#/$defs/recordType"
        },
        "window": {
          "$ref": "#/$defs/window"
        },
        "dataOrigins": {
          "type": "array",
          "maxItems": 128,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/id"
          }
        },
        "historyStart": {
          "oneOf": [
            {
              "$ref": "#/$defs/instant"
            },
            {
              "type": "null"
            }
          ],
          "description": "Declared earliest readable native SDK history boundary; null explicitly means unlimited."
        },
        "features": {
          "type": "object"
        },
        "importStart": {
          "$ref": "#/$defs/instant"
        }
      }
    },
    "stream": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "generation",
        "acknowledgedSequence"
      ],
      "properties": {
        "generation": {
          "$ref": "#/$defs/int64"
        },
