{
  "$schema": "klebb.datafile.v1",
  "meta": {
    "id": "mood",
    "label": "Mood",
    "emoji": "🙂",
    "order": 400,
    "view": {
      "enabled": true,
      "component": "generic-card",
      "display": {
        "template": "{mood:emoji}",
        "secondary": "{notes|(no notes)}",
        "emojiMap": {
          "mood": { "1": "😩", "2": "😴", "3": "😐", "4": "🙂", "5": "😄" }
        }
      }
    },
    "trends": {
      "enabled": true,
      "component": "line-chart",
      "field": "mood"
    },
    "calendar": {
      "enabled": true,
      "component": "day-marker",
      "marker": {
        "type": "field-emoji",
        "field": "mood",
        "emojiMap": { "1": "😩", "2": "😴", "3": "😐", "4": "🙂", "5": "😄" },
        "fallback": "🙂"
      }
    },
    "writeable": {
      "fromWebapp": true,
      "maxReadingsPerDay": 1,
      "requireAny": ["mood", "notes"],
      "inputs": [
        { "key": "mood", "type": "rating", "min": 1, "max": 5 },
        { "key": "notes", "type": "textarea" }
      ]
    }
  },
  "description": "Daily mood rating (1-5) with optional notes.",
  "data": [
