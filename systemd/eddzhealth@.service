# EddzHealth — Templated Systemd Unit
#
# Install:
#   sudo cp eddzhealth@.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#
# Per-instance environment file:
#   /etc/eddzhealth-<instance>.env  (0600, root-owned)
#
# Enable + start a specific instance (e.g. "eddy" or "chuck"):
#   sudo systemctl enable --now eddzhealth@eddy
#
# The %i placeholder = the instance name after the '@'.
#
# Required environment variables (per-instance env file):
#   HEALTH_HOME          — path to this instance's health dir
#   PORT                 — e.g. 10002, 10005
#   OPENCLAW_TOKEN       — bearer token for chat gateway
#
# Optional:
#   OPENCLAW_HOST, OPENCLAW_PORT, OPENCLAW_MODEL, OPENCLAW_TLS
#   CHAT_AGENT_NAME, CHAT_AGENT_EMOJI
#   HEALTH_RP_ID, HEALTH_RP_NAME, HEALTH_ORIGIN
#   HEALTH_INSTANCE_NAME
#   HEALTH_SYSTEM_PROMPT
#   SESSION_SECRET       — generated + persisted automatically if absent
#
# Example env file (/etc/eddzhealth-chuck.env):
#   HEALTH_HOME=/home/chuckshealth/health
#   PORT=10005
#   OPENCLAW_HOST=127.0.0.1
#   OPENCLAW_PORT=4100
#   OPENCLAW_TOKEN=<rotated-token-here>
#   OPENCLAW_TLS=false
#   CHAT_AGENT_NAME=Onyx
#   CHAT_AGENT_EMOJI=🔱
#   HEALTH_RP_ID=chuckshealth.axis.vorignet.com
#   HEALTH_ORIGIN=https://chuckshealth.axis.vorignet.com

[Unit]
Description=EddzHealth dashboard (instance %i)
After=network.target

[Service]
Type=simple
User=%i
Group=%i
WorkingDirectory=/home/minecraft/axis/workspace/.private/health/webapp
EnvironmentFile=/etc/eddzhealth-%i.env
ExecStart=/usr/bin/node server.js
Restart=on-failure
RestartSec=5
# Resource limits
LimitNOFILE=4096
# Security hardening
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/var/log
# (Per-instance HEALTH_HOME is added at install time via drop-in, see README)
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

[Install]
WantedBy=multi-user.target
