{
  "$schema": "klebb.datafile.v1",
  "meta": {
    "id": "body-temperature",
    "label": "Body Temperature",
    "emoji": "🌡️",
    "order": 26,
    "view": {
      "enabled": true,
      "component": "generic-card",
      "dateContext": "viewedDate",
      "display": {
        "template": "{celsius:round(1)}",
        "unit": "°C",
        "emptyHeadline": "No reading today",
        "thresholds": [
          { "ifField": "celsius", "max": 35.9, "colour": "#3399ff", "label": "Low" },
          { "ifField": "celsius", "min": 36.0, "max": 37.4, "colour": "#44ff88", "label": "Normal" },
          { "ifField": "celsius", "min": 37.5, "max": 38.4, "colour": "#ff7733", "label": "Mild fever" },
          { "ifField": "celsius", "min": 38.5, "colour": "#ff3333", "label": "Fever" }
        ]
      }
    },
    "trends": {
      "enabled": true,
      "component": "line-chart",
      "xKey": "date",
      "yKey": "celsius",
      "unit": "°C"
    },
    "writeable": {
      "fromWebapp": true,
      "todayAllowed": true,
      "pastAllowed": true,
      "futureAllowed": false,
      "maxReadingsPerDay": 3,
      "inputs": [
        { "key": "celsius", "type": "number", "label": "Temperature (°C)", "min": 30, "max": 45, "step": 0.1, "required": true },
        { "key": "note", "type": "text", "label": "Note", "placeholder": "optional" }
      ]
    }
  },
  "description": "Body temperature in Celsius. Array of rows: [{ date, celsius, note? }]. Multiple readings per day allowed (useful when unwell).",
  "data": []
}
