{
  "$schema": "klebb.datafile.v1",
  "meta": {
    "id": "activity",
    "label": "Activity",
    "emoji": "🏃",
    "order": 65,
    "view": {
      "enabled": true,
      "component": "combination-card",
      "layout": "stack",
      "dateContext": "viewedDate",
      "combines": [
        {
          "sourceId": "steps",
          "role": "primary",
          "label": "Steps",
          "accessor": "count",
          "unit": "steps"
        },
        {
          "sourceId": "active-minutes",
          "role": "secondary",
          "label": "Active minutes",
          "accessor": "minutes",
          "unit": "min"
        },
        {
          "sourceId": "workouts",
          "role": "annotation",
          "label": "Trained",
          "accessor": "trained"
        }
      ]
    }
  },
  "description": "Composite Activity card. Read-only view over steps + active-minutes + workouts. Edit values on the source cards; this one re-renders on change.",
  "data": []
}
