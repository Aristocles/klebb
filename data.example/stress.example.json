{
  "$schema": "klebb.datafile.v1",
  "meta": {
    "id": "stress",
    "label": "Stress",
    "emoji": "😤",
    "order": 64,
    "view": {
      "enabled": true,
      "component": "generic-card",
      "dateContext": "viewedDate",
      "display": {
        "template": "{rating}",
        "unit": "/ 5",
        "emptyHeadline": "Rate your stress",
        "thresholds": [
          { "ifField": "rating", "eq": 1, "colour": "#44ff88", "label": "Calm" },
          { "ifField": "rating", "eq": 2, "colour": "#66cc55", "label": "Easy" },
          { "ifField": "rating", "eq": 3, "colour": "#aaaa44", "label": "OK" },
          { "ifField": "rating", "eq": 4, "colour": "#ff7733", "label": "Tense" },
          { "ifField": "rating", "eq": 5, "colour": "#ff3333", "label": "Frazzled" }
        ]
      }
    },
    "writeable": {
      "fromWebapp": true,
      "todayAllowed": true,
      "pastAllowed": true,
      "futureAllowed": false,
      "maxReadingsPerDay": 1,
      "inputs": [
        { "key": "rating", "type": "rating", "label": "Stress level", "min": 1, "max": 5, "required": true },
        { "key": "note", "type": "text", "label": "Note", "placeholder": "e.g. deadline crunch" }
      ]
    }
  },
  "description": "Daily stress rating 1 (calm) to 5 (frazzled). Inverse polarity to mood/energy — a lower number is generally desirable.",
  "data": []
}
