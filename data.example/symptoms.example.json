{
  "$schema": "klebb.datafile.v1",
  "meta": {
    "id": "symptoms",
    "label": "Symptoms",
    "emoji": "🩹",
    "order": 85,
    "view": {
      "enabled": true,
      "component": "list-card",
      "display": {
        "primaryField": "symptom",
        "secondaryTemplate": "{severity|} {location|}",
        "emptyMessage": "No symptoms — tap Edit to add one.",
        "maxCharPreview": 60
      }
    },
    "writeable": {
      "fromWebapp": true,
      "inputs": [
        { "key": "symptom",  "type": "text",     "label": "Symptom",  "required": true, "maxLength": 120 },
        { "key": "severity", "type": "rating",   "label": "Severity (1-5)", "min": 1, "max": 5 },
        { "key": "location", "type": "text",     "label": "Location", "maxLength": 80 },
        { "key": "note",     "type": "textarea", "label": "Note",     "rows": 3, "maxLength": 500 }
      ]
    }
  },
  "description": "Persistent roster of symptoms you're currently monitoring. Unlike dated entry cards, rows here persist until explicitly deleted — this isn't a per-day log. Array shape: [{ symptom: string, severity?: 1-5, location?: string, note?: string, added?: ISO }].",
  "data": []
}
