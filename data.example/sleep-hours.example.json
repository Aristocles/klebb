{
  "$schema": "klebb.datafile.v1",
  "meta": {
    "id": "sleep-hours",
    "label": "Sleep",
    "emoji": "😴",
    "order": 30,
    "view": {
      "enabled": true,
      "component": "generic-card",
      "dateContext": "viewedDate",
      "display": {
        "template": "{hours:round(1)}",
        "unit": "hrs",
        "secondary": "{note|}",
        "emptyHeadline": "No sleep logged",
        "trendArrow": { "field": "hours" },
        "thresholds": [
          { "ifField": "hours", "max": 5.9, "colour": "#ff3333", "label": "Too little" },
          { "ifField": "hours", "min": 6.0, "max": 6.9, "colour": "#ff7733", "label": "Short" },
          { "ifField": "hours", "min": 7.0, "max": 9.0, "colour": "#44ff88", "label": "Good" },
          { "ifField": "hours", "min": 9.1, "colour": "#aaaa44", "label": "Long" }
        ]
      }
    },
    "trends": {
      "enabled": true,
      "component": "line-chart",
      "xKey": "date",
      "yKey": "hours",
      "unit": "hrs"
    },
    "writeable": {
      "fromWebapp": true,
      "todayAllowed": true,
      "pastAllowed": true,
      "futureAllowed": false,
      "maxReadingsPerDay": 1,
      "inputs": [
        { "key": "hours", "type": "number", "label": "Hours slept", "min": 0, "max": 16, "step": 0.25, "required": true },
        { "key": "note", "type": "text", "label": "Note", "placeholder": "e.g. woken by cat" }
      ]
    }
  },
  "description": "Total sleep duration for the night. One entry per date. Optimal band is 7-9 hours.",
  "data": []
}
