{
  "$schema": "klebb.datafile.v1",
  "meta": {
    "id": "weight",
    "label": "Weight",
    "emoji": "⚖️",
    "category": "vitals",
    "order": 20,
    "view": {
      "enabled": true,
      "component": "generic-card",
      "dateContext": "viewedDate",
      "display": {
        "primary": "latest.kg",
        "unit": "kg",
        "subtitle": "Logged {date}",
        "template": "{kg:round(1)}",
        "secondary": "{note|}",
        "emptyHeadline": "No weight logged",
        "trendArrow": {
          "field": "kg"
        }
      }
    },
    "trends": {
      "enabled": true,
      "component": "line-chart",
      "title": "Weight",
      "xAxis": "date",
      "series": [
        {
          "field": "kg",
          "label": "kg"
        }
      ],
      "yAxisLabel": "kg"
    },
    "calendar": {
      "enabled": true,
      "component": "day-marker",
      "marker": {
        "type": "trend-arrow",
        "field": "kg",
        "up": "⬆️",
        "down": "⬇️",
        "flat": "➡️",
        "fallback": "⚖️"
      }
    },
    "writeable": {
      "fromWebapp": true,
      "pastAllowed": true,
      "todayAllowed": true,
      "futureAllowed": false,
      "maxReadingsPerDay": 1,
      "inputs": [
        {
          "key": "kg",
          "type": "number",
          "label": "Weight (kg)",
          "min": 0,
          "max": 500,
          "step": 0.1,
          "required": true
        },
        {
          "key": "note",
          "type": "text",
          "label": "Note",
          "placeholder": "optional"
        }
      ]
    }
  },
  "description": "Body weight log. Append new entries as { date: 'YYYY-MM-DD', kg: number, notes?: string }. Keep chronological.",
  "data": []
}