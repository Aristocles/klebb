{
  "$schema": "klebb.datafile.v1",
  "meta": {
    "id": "energy",
    "label": "Energy",
    "emoji": "⚡",
    "order": 62,
    "view": {
      "enabled": true,
      "component": "generic-card",
      "dateContext": "viewedDate",
      "display": {
        "template": "{rating}",
        "unit": "/ 5",
        "emptyHeadline": "Rate your energy",
        "thresholds": [
          { "ifField": "rating", "eq": 1, "colour": "#ff3333", "label": "Drained" },
          { "ifField": "rating", "eq": 2, "colour": "#ff7733", "label": "Low" },
          { "ifField": "rating", "eq": 3, "colour": "#aaaa44", "label": "OK" },
          { "ifField": "rating", "eq": 4, "colour": "#66cc55", "label": "Good" },
          { "ifField": "rating", "eq": 5, "colour": "#44ff88", "label": "Wired" }
        ]
      }
    },
    "writeable": {
      "fromWebapp": true,
      "todayAllowed": true,
      "pastAllowed": true,
      "futureAllowed": false,
      "maxReadingsPerDay": 1,
      "inputs": [
        { "key": "rating", "type": "rating", "label": "Energy level", "min": 1, "max": 5, "required": true },
        { "key": "note", "type": "text", "label": "Note", "placeholder": "optional" }
      ]
    }
  },
  "description": "Daily energy rating 1 (drained) to 5 (wired). One entry per day.",
  "data": []
}
