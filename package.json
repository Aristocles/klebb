    "url": "git+https://github.com/Aristocles/klebb.git"
  },
  "bugs": {
    "url": "https://github.com/Aristocles/klebb/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@simplewebauthn/browser": "^13.3.0",
    "@simplewebauthn/server": "^13.3.0",
    "marked": "^18.0.2"
  }
